{
  "name": "trade-republic-importer-addon",
  "version": "1.3.2",
  "description": "Import Trade Republic CSV exports into Wealthfolio",
  "type": "module",
  "main": "dist/addon.js",
  "author": "blastik",
  "license": "MIT",
  "homepage": "https://github.com/blastik/trade-republic-importer-addon",
  "repository": {
    "type": "git",
    "url": "https://github.com/blastik/trade-republic-importer-addon.git"
  },
  "keywords": [
    "wealthfolio",
    "addon",
    "trade-republic",
    "importer",
    "csv"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "dev:server": "wealthfolio dev",
    "clean": "rm -rf dist",
    "bundle": "pnpm build && zip dist/trade-republic-importer-addon.zip manifest.json dist/addon.js README.md",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "papaparse": "^5.6.1"
  },
  "peerDependencies": {
    "@wealthfolio/addon-sdk": "^3.7.0",
    "@wealthfolio/ui": "^3.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "@wealthfolio/addon-dev-tools": "^3.7.0",
    "@wealthfolio/addon-sdk": "^3.7.0",
    "@wealthfolio/ui": "^3.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "files": [
    "dist/",
    "manifest.json",
    "README.md"
  ]
}
